RAG_DB_HOST=127.0.0.1
RAG_DB_NAME=hs_rag
RAG_DB_USER=rag
RAG_DB_PASSWORD=replace-with-local-secret
RAG_DB_PORT=55432

# Comma-separated keys or a JSON array. Keep real keys in the ignored .env file.
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_MODERATION_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_MAX_INPUT_CHARS=8000
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_MAX_CONTEXT_CHARS=6000
GROQ_REASONING_EFFORT=medium
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_WAIT_SECONDS=45
GROQ_TEMPERATURE=0.2

# Notebook 03 controls. Custom questions remain editable in the notebook.
RAG_TEST_RUN_TESTS=true
RAG_TEST_USE_RETRIEVAL_CACHE=true
RAG_TEST_MIN_TURN_INTERVAL_SECONDS=40
RAG_TEST_CASE_IDS=
RAG_TEST_RUN_CUSTOM_CASE=false
