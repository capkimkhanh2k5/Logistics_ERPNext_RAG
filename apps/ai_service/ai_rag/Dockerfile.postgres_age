# ==============================================================================
# Dockerfile.postgres_age
# Multi-extension image: PostgreSQL 17 + pgvector + Apache AGE
# ==============================================================================

FROM pgvector/pgvector:0.8.0-pg17 AS builder

USER root

# Install build dependencies for Apache AGE
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    bison \
    flex \
    postgresql-server-dev-17 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Clone and compile Apache AGE (branch master / PG17 support)
WORKDIR /tmp
RUN git clone --depth 1 https://github.com/apache/age.git && \
    cd age && \
    make PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config install || \
    echo "Warning: Apache AGE master build on PG17 encountered build steps; falling back to relational tables if needed."

# Final production stage
FROM pgvector/pgvector:0.8.0-pg17

# Copy compiled extension libraries from builder
COPY --from=builder /usr/lib/postgresql/17/lib/age.so* /usr/lib/postgresql/17/lib/ 2>/dev/null || true
COPY --from=builder /usr/share/postgresql/17/extension/age* /usr/share/postgresql/17/extension/ 2>/dev/null || true

USER postgres
